# --- bookcast: API keys ---
# Copy this file to config.env and fill in your real keys.
# config.env is git-ignored and will never be uploaded.

# Anthropic Claude API — for generate_talk.py (auto-writing talk script from a book).
# OPTIONAL: if you have Claude Code (`claude` CLI) installed, generate_talk.py will
# fall back to it and use your Claude Code quota instead. Leave this blank if so.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# MiniMax T2A v2 — used by tts_minimaxi.py for narration (required)
# Get one at https://platform.minimaxi.com/
MINIMAX_API_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MINIMAX_GROUP_ID=placeholder

# Apimart — used by img_apimart.py for image generation (gpt-image-2, required)
# Get one at https://apimart.ai/
APIMART_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
